################################################################
# Manage anchor_vault_k deployment through Crypto Infrastructure as Code
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_anchor_vault_k" "svm::deploy_program" {
    description = "Deploy anchor_vault_k program"
    program = svm::get_program_from_anchor_project("anchor_vault_k") 
    authority = signer.authority
    payer = signer.payer
}
